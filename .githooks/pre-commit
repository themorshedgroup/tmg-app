#!/bin/sh
# Rebuilds build/*.js from src/*.jsx before every commit, so the deployed pages
# can never be stale relative to their source.
#
# Stages the whole build/ directory rather than diffing it: `git diff` only
# reports tracked files, so a newly generated build output would otherwise be
# silently left out of the commit. Scoped to build/ so it cannot sweep up work
# from another Claude session sharing this tree.
set -e

if [ ! -d tools/build/node_modules ]; then
  echo "pre-commit: build deps missing. Run:  npm install --prefix tools/build" >&2
  exit 1
fi

node tools/build/build-jsx.mjs >/dev/null
git add -A -- build/

staged=$(git diff --cached --name-only -- build/ 2>/dev/null || true)
if [ -n "$staged" ]; then
  echo "pre-commit: build outputs staged:"; echo "$staged" | sed 's/^/  /'
fi
exit 0
